# blitzyxsc — sample environment variables.
# Copy to .env and edit. All vars are prefixed with BLITZYXSC_.

# Branding (do not change)
BLITZYXSC_BRAND=blitzyxsc
BLITZYXSC_AUTHOR="Blitz (blitzlabx)"

# Server
BLITZYXSC_HOST=0.0.0.0
BLITZYXSC_PORT=8000

# CORS — JSON array of allowed origins
BLITZYXSC_CORS_ORIGINS=["*"]

# Provider priority order — JSON array. First success wins.
BLITZYXSC_PROVIDER_ORDER=["composable","syndication","nitter","twscrape","snscrape","rss"]

# Timeouts (seconds)
BLITZYXSC_SYNDICATION_TIMEOUT=10.0
BLITZYXSC_NITTER_TIMEOUT=15.0
BLITZYXSC_TWSCRAPE_TIMEOUT=30.0
BLITZYXSC_SNSCRAPE_TIMEOUT=30.0
BLITZYXSC_COMPOSABLE_TIMEOUT=15.0
BLITZYXSC_RSS_TIMEOUT=15.0

# Nitter instances — JSON array, tried in order
BLITZYXSC_NITTER_INSTANCES=["https://nitter.meowing.monster","https://nitter.poast.org","https://nitter.privacydev.net","https://nitter.cz","https://nitter.woodland.cafe","https://nitter.1d4.us","https://nitter.kavin.rocks","https://nitter.unixfox.eu"]

# Composable (fxtwitter) base URL
BLITZYXSC_COMPOSABLE_BASE_URL=https://api.fxtwitter.com

# Syndication (Twitter CDN) endpoints
BLITZYXSC_SYNDICATION_BASE_URL=https://cdn.syndication.twimg.com
BLITZYXSC_SYNDICATION_TIMELINE_URL=https://cdn.syndication.twimg.com/timeline/profile

# Caching
BLITZYXSC_CACHE_TTL_SECONDS=60

# Default page sizes
BLITZYXSC_DEFAULT_PAGE_SIZE=20
BLITZYXSC_MAX_PAGE_SIZE=100

# User agent (must be a real browser UA or fxtwitter returns 403)
BLITZYXSC_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# twscrape account pool (optional — only used if twscrape is installed)
BLITZYXSC_TWSCRAPE_DB=/tmp/blitzyxsc_twscrape.db
